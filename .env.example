# Public site URL used for SEO metadata and social share images.
# Use the final production URL after the Vercel domain is ready.
NEXT_PUBLIC_SITE_URL=https://your-final-domain.com

# Resend powers the on-site booking form email notifications.
# Add the real value in Vercel Project Settings -> Environment Variables.
RESEND_API_KEY=

# Where booking requests should be sent.
BOOKING_TO_EMAIL=panthercityhelpersfw@gmail.com

# Use onboarding@resend.dev for testing. Replace with a verified domain sender later.
RESEND_FROM_EMAIL="Panther City Bookings <onboarding@resend.dev>"
